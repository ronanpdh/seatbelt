# The recording gateway, built from the repository alone (no `uv build` first), so a host that
# builds from git, such as Coolify, can use it directly. See docs/deploy/gateway.md.
# Build:  docker build -f docker/Dockerfile.gateway -t seatbelt-gateway .
# Run:    mount the config's directory at /etc/seatbelt (the directory, so a replaced
#         gateway.yaml is seen and reloaded; on a PaaS without directory mounts, the file),
#         give /var/lib/seatbelt a volume, and
#         pass the provider keys as env. The signing key is a file the config names (readable
#         by uid 1000) or SEATBELT_SIGNING_KEY in the env. The config must set
#         `listen: 0.0.0.0:8080` to be reachable from outside the container.
# uv, pinned by version and digest; it moves by hand with the workflows' uv and pyproject's
# uv_build range (Dependabot ignores its version updates)
FROM ghcr.io/astral-sh/uv:0.12.20@sha256:100047e74f30778ab704942321a09750d6158739573ff58bf3924085cc6cd2d8 AS uv

# the digest pins the image; Dependabot keeps it current
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS build
COPY --from=uv /uv /bin/uv
ENV UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
# offline, so nothing is fetched that the lock does not pin: the requirements, hash-pinned, come
# from uv.lock, and the wheel is built with the uv_build backend inside uv (a uv outside
# pyproject's uv_build range fails here rather than download one)
RUN uv export --locked --offline --no-dev --extra gateway --no-emit-project -o /requirements.txt \
    && uv build --wheel --offline --out-dir /dist

FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# dependencies pinned by hash from uv.lock, then seatbelt itself without resolving anything
# further
COPY --from=build /requirements.txt /tmp/requirements.txt
COPY --from=build /dist/*.whl /tmp/
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && pip install --no-cache-dir --no-deps /tmp/*.whl && rm -f /tmp/*.whl /tmp/requirements.txt \
    && mkdir -p /var/lib/seatbelt && chown 1000:1000 /var/lib/seatbelt
USER 1000
VOLUME /var/lib/seatbelt
EXPOSE 8080
ENTRYPOINT ["seatbelt", "gateway", "serve", "--config", "/etc/seatbelt/gateway.yaml"]
